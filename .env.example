# SynapsVault Frontend — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# ────────────────────────────────────────────────────────────────────────────
# Required Configuration
# ────────────────────────────────────────────────────────────────────────────

# Backend API URL (SynapsVault/backend)
#
# Development: leave EMPTY. The Vite dev server proxies every API route
#   (/resources, /agent, /registry, /publishers, /buyers, /payments) to
#   VITE_DEV_PROXY_TARGET, so there are no CORS issues. Start the backend with
#   `npm run dev` in SynapsVault/backend.
#
# Production: REQUIRED. Set it to the deployed backend, e.g.
#   https://api.yourdomain.com — and add your frontend origin to the backend's
#   ALLOWED_ORIGINS. If it is missing, API calls hit the static host and get
#   index.html back; the app reports this as "The API returned a web page".
VITE_API_URL=

# Where the dev server proxies API requests (development only).
# VITE_DEV_PROXY_TARGET=http://localhost:3000

# Stellar network: testnet (default) or mainnet.
# Controls payments, wallet signing, explorer links, and the sidebar badge.
VITE_NETWORK=testnet

# ────────────────────────────────────────────────────────────────────────────
# Authentication & Publishing
# ────────────────────────────────────────────────────────────────────────────

# Publisher API Key (DEPRECATED — do not use)
#
# Raw API keys must never be embedded in the frontend bundle. This variable is
# retained only for backwards compatibility and will be removed in a future
# release. Use the signing-proxy configuration below instead.
#
# NOTE: If you do set this value, it is bundled into the client and is visible
# to anyone who loads the app. It is a client-visible identifier sent in the
# `x-api-key` request header — NOT a shared secret and NOT an HMAC signing key.
# Do not put secrets here. Authentication and integrity are enforced
# server-side over TLS; the backend validates this key on every request.
# VITE_API_KEY=

# Signing Proxy URL (required for authenticated/publishing operations)
#
# All privileged requests are routed through a server-side signing proxy that
# holds the API key and signs requests on the frontend's behalf. Point this at
# the deployed proxy, e.g. https://signing.yourdomain.com
VITE_SIGNING_PROXY_URL=

# Signing Proxy Token
#
# Short-lived, scoped token issued by the signing proxy for this session. It
# grants only the permissions needed by the frontend and is safe to expose to
# the browser (unlike a raw API key). Obtain it from your auth flow.
VITE_SIGNING_PROXY_TOKEN=

# Publisher authentication is handled via wallet-signature login: the user
# signs a challenge with their Stellar wallet, and the backend issues a
# session token that the frontend stores and sends with subsequent requests.
# No API key needs to be configured here.

# ────────────────────────────────────────────────────────────────────────────
# Optional: Observability & Monitoring
# ────────────────────────────────────────────────────────────────────────────

# Sentry DSN for error tracking
# Get from https://sentry.io after creating a project
VITE_SENTRY_DSN=

# ────────────────────────────────────────────────────────────────────────────
# Feature Flags & Advanced
# ────────────────────────────────────────────────────────────────────────────

# Enable development mode features (debug logging, longer timeouts)
# Comment out or set to false for production
# VITE_DEBUG=true

# Enable verbose logging in console
# VITE_VERBOSE_LOGGING=true
